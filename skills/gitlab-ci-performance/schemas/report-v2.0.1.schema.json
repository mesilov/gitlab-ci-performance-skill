      "type": "object",
      "additionalProperties": false,
      "properties": {
        "history_limit": {
          "enum": [
            64
          ]
        },
        "windows": {
          "const": [
            32,
            64
          ]
        },
        "default_window": {
          "enum": [
            32
          ]
        },
        "baseline_limit": {
          "enum": [
            10
          ]
        },
        "minimum_baseline": {
          "enum": [
            3
          ]
        },
        "baseline_eligibility": {
          "enum": [
            "successful_complete_job_in_successful_pipeline_latest_success_per_pipeline"
          ]
        },
        "history_scope": {
          "enum": [
            "exploratory_cross_ref"
          ]
        },
        "category_cost": {
          "enum": [
            "union_of_recorded_intervals_per_successful_run"
          ]
        },
        "queue_spike_rule": {
          "enum": [
            "wait>max(30,3*median);previous-success-N>=3"
          ]
