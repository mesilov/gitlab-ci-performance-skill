              "stale",
              "source_snapshot"
            ]
          },
          "pipeline_status": {
            "const": "success"
          }
        }
      }
    }
  },
  "required": [
    "schema_version",
    "calculation_version",
    "parser_version",
    "kind",
    "generated_at",
    "timezone",
    "project",
    "inputs",
    "method",
    "snapshot_summary",
    "types",
    "default_type_id",
    "attention_type_id",
    "jobs",
    "pipelines",
    "details",
    "same_ref_views",
    "coverage",
    "baseline_jobs"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/ci-report/report-v2.0.1.schema.json",
  "$defs": {
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "enum": [
            "image_build"
          ]
        },
        "start_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "end_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "span_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "push_coverage": {
          "enum": [
            "unknown",
            "outside",
            "recorded"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "label",
        "start_seconds",
        "end_seconds",
        "span_seconds",
        "push_coverage",
        "operations"
      ]
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "rerun_attempts",
        "successful_attempts",
        "status_counts",
        "execution",
        "queue",
        "lifecycle"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "rerun_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "successful_attempts": {
          "type": "integer",
          "minimum": 0
        },
        "status_counts": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "execution": {
          "$ref": "#/$defs/metric"
        },
        "queue": {
          "$ref": "#/$defs/metric"
        },
        "lifecycle": {
          "$ref": "#/$defs/metric"
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "current_seconds",
        "baseline_seconds",
        "delta_seconds",
        "delta_percent"
      ],
      "properties": {
        "status": {
          "enum": [
            "regressed",
            "improved",
            "stable",
            "insufficient_data",
            "new_job",
            "missing_job",
            "overlap"
          ]
        },
        "current_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "baseline_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "delta_seconds": {
          "type": [
            "number",
            "null"
          ]
        },
        "delta_percent": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "detail": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "job_id": {
          "type": "integer",
          "minimum": 1
        },
        "trace_status": {
          "enum": [
            "available",
            "partial",
            "not_run",
            "empty",
            "erased",
            "unavailable",
            "disabled"
          ]
        },
        "trace_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "trace_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "processed_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "trace_lines": {
          "type": "integer",
          "minimum": 0
        },
        "timestamp_lines": {
          "type": "integer",
          "minimum": 0
        },
        "analyzed_at": {
          "type": "string",
          "format": "date-time"
        },
        "parser_version": {
          "enum": [
            "2.0.0"
          ]
        },
        "phases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "builds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/build"
          }
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "enum": [
              "missing_job_start",
              "truncated_trace",
              "incomplete_sections",
              "invalid_section_timing",
              "unmatched_section_end",
              "incomplete_commands",
              "estimated_command_intervals",
              "ambiguous_build_boundary",
              "duplicate_frames",
              "incomplete_operations",
              "incomplete_substeps",
              "missing_operation_durations",
              "partial_build_span",
              "inferred_operation_positions",
              "missing_operation_positions",
              "unknown_push_coverage",
              "missing_timestamps",
              "trace_disabled",
              "job_not_run",
              "trace_erased",
              "trace_forbidden",
              "trace_unavailable",
              "trace_timeout",
              "trace_request_failed",
              "trace_byte_limit",
              "active_trace",
              "trace_cache_write_failed",
              "details_not_collected",
              "collection_not_atomic",
              "details_retained_64_per_type",
              "traces_may_be_unavailable",
              "runner_log_truncated"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "job_id",
        "trace_status",
        "trace_sha256",
        "trace_bytes",
        "processed_bytes",
        "trace_lines",
        "timestamp_lines",
        "analyzed_at",
        "parser_version",
        "phases",
        "builds",
        "commands",
        "limitations"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "enum": [
            "export_unpack",
            "context_copy",
            "base_image",
            "dependencies",
            "builder_startup",
            "runner_prepare",
            "runner_checkout",
            "runner_artifacts",
            "runner_cleanup",
            "queue",
            "other",
            "prepare_executor",
            "prepare_environment",
            "checkout_sources",
            "execute_script",
            "download_artifacts",
            "upload_artifacts",
            "cleanup",
            "runner_phase",
            "unknown_operation",
            "command",
            "export_layers",
            "export_manifest",
            "export_manifest_list",
            "export_config",
            "unpack_local",
            "export_tarball",
            "push_layers",
            "push_manifest"
          ]
        },
        "category": {
          "enum": [
            "export_unpack",
            "context_copy",
            "base_image",
            "dependencies",
            "builder_startup",
            "runner_prepare",
            "runner_checkout",
            "runner_artifacts",
            "runner_cleanup",
            "queue",
            "other"
          ]
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "start_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "end_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "first_line": {
          "type": "integer",
          "minimum": 1
        },
        "last_line": {
          "type": "integer",
          "minimum": 1
        },
        "timing_source": {
          "enum": [
            "runner_section",
            "buildkit_reported",
            "logged_interval"
          ]
        },
        "position_source": {
          "enum": [
            "section_markers",
            "log_timestamps",
            "unknown"
          ]
        },
        "cached": {
          "type": "boolean"
        },
        "complete": {
          "type": "boolean"
        },
        "substeps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "id",
        "label",
        "category",
        "duration_seconds",
        "start_seconds",
        "end_seconds",
        "first_line",
        "last_line",
        "timing_source",
        "position_source",
        "cached",
        "complete",
        "substeps"
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "stage",
        "ref",
        "purpose",
        "current",
        "baseline",
        "execution_change",
        "queue_change",
        "drivers",
        "latest_attempt_id"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/purpose"
        },
        "purpose_from_catalog": {
          "type": "boolean",
          "description": "False identifies a generated UI fallback. If absent in legacy reports, preserve purpose text verbatim."
        },
        "current": {
          "$ref": "#/$defs/cohort"
        },
        "baseline": {
          "$ref": "#/$defs/cohort"
        },
        "execution_change": {
          "$ref": "#/$defs/comparison"
        },
        "queue_change": {
          "$ref": "#/$defs/comparison"
        },
        "drivers": {
          "type": "array",
          "items": {
            "enum": [
              "execution",
              "queue"
            ]
          }
        },
        "latest_attempt_id": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "known",
        "missing",
        "sum_seconds",
        "p50_seconds",
        "p95_seconds",
        "max_seconds"
      ],
      "properties": {
        "known": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "sum_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p50_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "p95_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "description": "Агрегат известных измерений в секундах. null не заменяется нулём; при known=0 все времена равны null."
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_ids",
        "from",
        "to",
        "attempts"
      ],
      "properties": {
        "pipeline_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "attempts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "pipeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ref",
        "sha",
        "status",
        "source",
        "created_at",
        "started_at",
        "finished_at",
        "duration_seconds",
        "queued_seconds",
        "web_url"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "ref": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "started_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "finished_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "duration_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Собственное время pipeline из GitLab API duration, в секундах; не сумма времён джоб."
        },
        "queued_seconds": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Время ожидания из GitLab API queued_duration, в секундах; null означает отсутствие измерения."
        },
        "web_url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "host",
        "web_url",
        "default_branch"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+(?::[0-9]+)?$"
        },
        "web_url": {
          "type": "string",
          "format": "uri"
        },
        "default_branch": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "purpose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "source_url",
        "verified_at"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "runner": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "description"
          ],
          "properties": {
            "id": {
              "type": "integer",
              "minimum": 1
            },
            "description": {
              "type": "string"
            }
          }
        }
      ]
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "window",
        "baseline_window",
        "current_period",
        "baseline_period",
        "overlap_pipeline_ids",
        "situation",
        "regression_count",
        "insufficient_count",
        "latest_pipeline",
        "groups"
      ],
      "properties": {
        "ref": {
          "type": "string"
        },
        "window": {
          "type": "integer",
          "minimum": 1
        },
        "baseline_window": {
          "type": "integer",
          "minimum": 1
        },
        "current_period": {
          "$ref": "#/$defs/period"
        },
        "baseline_period": {
          "$ref": "#/$defs/period"
        },
        "overlap_pipeline_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "situation": {
          "enum": [
            "attention",
            "insufficient_data",
            "no_regression"
          ]
        },
        "regression_count": {
          "type": "integer",
          "minimum": 0
        },
        "insufficient_count": {
          "type": "integer",
          "minimum": 0
        },
        "latest_pipeline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/pipeline"
            }
          ]
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    }
  }
}
