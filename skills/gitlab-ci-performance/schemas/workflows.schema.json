{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "project",
    "cross_pipeline_policy",
    "unknowns",
    "evidence",
    "workflows"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "kind": {
      "const": "workflows"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "path"
      ],
      "properties": {
        "host": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.-]+(?::[0-9]+)?$"
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cross_pipeline_policy": {
      "const": "unsupported"
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_url",
          "commit",
          "ref",
          "config_sha256",
          "verified_at",
          "pipeline_ids",
          "pipeline_shas"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          },
          "pipeline_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "pipeline_shas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "purpose",
          "type",
          "versions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "chain",
              "independent"
            ]
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "evidence_ids",
                "selection",
                "completion",
                "success",
                "unknown_membership",
                "jobs"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "selection": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "refs",
                    "sources"
                  ],
                  "properties": {
                    "refs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    },
                    "sources": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "uniqueItems": true
                    }
                  }
                },
                "completion": {
                  "const": "all_required_terminal"
                },
                "success": {
                  "const": "required_success"
                },
                "unknown_membership": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "jobs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "name",
                      "stage",
                      "required",
                      "manual",
                      "needs",
                      "parallel_group"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "stage": {
                        "type": "string"
                      },
                      "required": {
                        "type": "boolean"
                      },
                      "manual": {
                        "type": "boolean"
                      },
                      "needs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        },
                        "uniqueItems": true
                      },
                      "parallel_group": {
                        "type": [
                          "string",
                          "null"
                        ]
                      }
                    }
                  },
                  "minItems": 1
                }
              }
            },
            "minItems": 1
          }
        }
      },
      "minItems": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gitlab-ci-performance:workflows:2"
}
